"Formula":{"Expression":"[benofficial2.PitlaneHelper.DistanceToTarget] * 1000.0"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Roboto","FontWeight":"Medium","FontSize":25.0,"Text":"100 m to pit entrance","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":30.0,"Left":0.0,"Top":0.0,"Visible":true,"BlinkPhasisInverted":false,"Width":630.0,"Name":"Distance Label","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"if (isnull($prop('benofficial2.PitlaneHelper.MaxDistanceToTarget'), 0) <= 0)\r\n\treturn \"Unknown pit markers\"\r\n\r\nlet distance = isnull($prop('benofficial2.PitlaneHelper.DistanceToTarget') * 1000.0, 0)\r\nlet units = \"m\"\r\n\r\nif ($prop('SpeedLocalUnit') == 'MPH')\r\n{\r\n\tunits = 'ft'\r\n\tdistance *= 3.28084\r\n}\r\n\r\nlet target = isnull($prop('benofficial2.PitlaneHelper.Target'), \"\")\r\nlet destination = \"\"\r\nif (target == \"PitEntry\")\r\n\tdestination = \" to pit entrance\"\r\nelse if (target == \"PitBox\")\r\n\tdestination = \" to pit box\"\r\nelse if (target == \"PitExit\")\r\n\tdestination = \" to pit exit\"\r\n\r\nreturn String(Number(distance).toFixed(0)) + ' ' + units + destination"},"Mode":2}}}],"BackgroundColor":"#00FFFFFF","Height":60.0,"Left":10.0,"Top":10.0,"Visible":true,"BlinkPhasisInverted":false,"Width":630.0,"Name":"Distance","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[benofficial2.PitlaneHelper.DistanceVisible]"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"Visible","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"if (!isGameRunning() || isReplayPlaying())\r\n\treturn false\r\n\r\nif (isnull($prop('benofficial2.Player.InPitBox'), false))\r\n\treturn false\r\n\r\nconst aproachingPits = isnull($prop('benofficial2.Player.AproachingPits'), false)\r\nconst inPit = isnull($prop('benofficial2.Player.InPit'), false)\r\nreturn aproachingPits || inPit"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontWeight":"Bold","FontSize":12.0,"Text":"New version available","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#FFFF0000","BorderStyle":{"RadiusTopLeft":3,"RadiusTopRight":3,"RadiusBottomLeft":3,"RadiusBottomRight":3},"Height":18.0,"Left":245.0,"Top":5.0,"Visible":false,"BlinkPhasisInverted":false,"Width":205.0,"IsFreezed":true,"Name":"Version","RenderingSkip":50,"MinimumRefreshIntervalMS":500.0,"Bindings":{"Visible":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"return checkVersion(g_VersionName, g_VersionNumber) || getErrorMessage() != ''","PreExpression":"// Download new version at https://github.com/fixfactory/bo2-official-overlays\r\nconst g_VersionName = 'pitlanehelper'\r\nconst g_VersionNumber = '5.2'"},"Mode":2},"Text":{"Formula":{"JSExt":1,"Interpreter":1,"Expression":"const errorMessage = getErrorMessage()\r\nreturn errorMessage != '' ? errorMessage : \"New version available\""},"Mode":2}}}],"MinimumRefreshIntervalMS":0.0}],"SnapToGrid":false,"HideLabels":true,"ShowForeground":true,"ForegroundOpacity":100.0,"ShowBackground":true,"BackgroundOpacity":100.0,"ShowBoundingRectangles":false,"GridSize":10,"Images":[],"Metadata":{"ScreenCount":1.0,"InGameScreensIndexs":[0],"IdleScreensIndexs":[0],"MainPreviewIndex":0,"IsOverlay":true,"OverlaySizeWarning":false,"MetadataVersion":2.0,"EnableOnDashboardMessaging":true,"PitScreensIndexs":[],"PreferredTouchMode":0,"SimHubVersion":"9.11.22","Title":"benofficial2 - iRacing Pitlane Helper","Author":"twitch.tv/benofficial2","Width":650.0,"Height":500.0,"DashboardVersion":""},"ShowOnScreenControls":true,"IsOverlay":true,"EnableClickThroughOverlay":true,"EnableOnDashboardMessaging":true,"UseStrictJSIsolation":false,"UseStrictJSIsolationWarning":true}